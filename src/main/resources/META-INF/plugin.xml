<idea-plugin>
    <id>ru.axefu.jover.intellij</id>
    <name>Jover</name>
    <version>1.0.0</version>
    <vendor>AxeFu</vendor>

    <description>
        IntelliJ IDEA support for Jover operator overloading:
        + -> add, - -> subtract, * -> multiply, / -> divide.
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <daemon.highlightInfoFilter implementation="ru.axefu.jover.intellij.JoverHighlightInfoFilter"/>
        <implicitUsageProvider implementation="ru.axefu.jover.intellij.JoverImplicitUsageProvider"/>
    </extensions>
</idea-plugin>
